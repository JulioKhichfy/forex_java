# Copie para .env (que é ignorado pelo Git) ou defina como variáveis de ambiente do Windows.
# Use UMA das duas formas para a chave do Jev:
TYPESAFE_API_KEY=
# ou o caminho de um arquivo que contém só a chave:
JEV_API_KEY_FILE=C:/Users/julio/FOREX_JEV/Api_Key_Jev.txt

# Postgres local (só escuta em 127.0.0.1)
PG_PASSWORD=jevlocal

# Pasta do data lake (disco local)
LAKE_ROOT=C:/Users/julio/FOREX_JEV/jev-lake
