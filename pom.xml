<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jevforex</groupId>
    <artifactId>jev-forex</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Jev Forex</name>

    <modules>
        <module>jev-core</module>
        <module>jev-typesafe</module>
        <module>jev-lake</module>
        <module>jev-normalize</module>
        <module>jev-features</module>
        <module>jev-ml</module>
        <module>jev-collect</module>
        <module>jev-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <duckdb.version>1.3.1.0</duckdb.version>
        <pdfbox.version>3.0.7</pdfbox.version>
        <smile.version>4.3.0</smile.version>
        <commons-csv.version>1.14.1</commons-csv.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-typesafe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-lake</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-collect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-normalize</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-features</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jevforex</groupId>
                <artifactId>jev-ml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.haifengl</groupId>
                <artifactId>smile-core</artifactId>
                <version>${smile.version}</version>
            </dependency>
            <!-- motor analítico do lake: lê e escreve Parquet com SQL, embarcado (documento mestre, cap. 4) -->
            <dependency>
                <groupId>org.duckdb</groupId>
                <artifactId>duckdb_jdbc</artifactId>
                <version>${duckdb.version}</version>
            </dependency>
            <!-- CSV com campos de várias linhas (acervo de discursos do BIS) -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <!-- texto de PDFs (atas e discursos anexos) -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
