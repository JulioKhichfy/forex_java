<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jevforex</groupId>
        <artifactId>jev-forex</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>jev-ml</artifactId>
    <name>jev-ml</name>
    <description>Walk-forward com embargo e cofre, modelos A/B/C (Smile), métricas e relatório.</description>

    <dependencies>
        <dependency>
            <groupId>com.jevforex</groupId>
            <artifactId>jev-lake</artifactId>
        </dependency>
        <!-- Smile (GPL v3): gradient boosting de árvores. Árvores não usam BLAS: as bibliotecas nativas
             (OpenBLAS/ARPACK/JavaCPP de todas as plataformas) e o DuckDB antigo que ele arrasta ficam de fora. -->
        <dependency>
            <groupId>com.github.haifengl</groupId>
            <artifactId>smile-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.duckdb</groupId>
                    <artifactId>duckdb_jdbc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
